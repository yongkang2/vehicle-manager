{
  "name": "stellantis-vehicle-manager",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4411 --strictPort",
    "dev:server": "tsx server/main.ts",
    "build": "node scripts/sync-version.mjs && tsc -b && tsc -p tsconfig.server.json && vite build",
    "start": "node dist-server/server/main.js",
    "test": "tsx --test test/*.test.ts",
    "lint": "oxlint",
    "preview": "vite preview",
    "package:portable": "npm run build && node scripts/package.mjs",
    "version": "node scripts/sync-version.mjs && git add shared/version.ts",
    "verify:portable": "node scripts/verify-portable.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "dependencies": {
    "antd": "^6.6.7",
    "archiver": "^8.0.0",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "lucide-react": "^1.61.0",
    "multer": "^2.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "unzipper": "^0.12.5",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/unzipper": "^0.10.11",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
